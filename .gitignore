# Generated by Cargo
# will have compiled files and executables
/debug/
target/

# Cargo.lock is committed so every machine builds the same dependency versions.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Your own control rebinds - written by the game (Settings > Controller)
settings/bindings.ron

# Snapshot of the drag model before the tail / fuselage / parasitic change.
drag-polar-before/
